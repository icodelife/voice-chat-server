{
  "$schema": "node_modules/wrangler/config-schema.json",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "RoomSession",
        "name": "SFU_ROOM"
      }
    ]
  },
  "main": "worker.ts",
  "migrations": [
    {
      "new_sqlite_classes": [
        "RoomSession"
      ],
      "tag": "v1"
    }
  ],
  "name": "voice-chat-server",
  "observability": {
    "enabled": true,
    "redact_query_string": true
  },
  "placement": {
    "mode": "smart"
  },
  "vars": {
    "DISABLE_ORIGIN_CHECK": "true",
    "ROOM_APPS_ENABLED": "false",
    "ALLOW_PASSWORD_ROOMS": "true"
  },
  "workers_dev": true
}